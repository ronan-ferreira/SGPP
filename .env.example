# ============================================================
#  EXEMPLO DE CONFIGURAÇÃO — copie para .env e preencha
#  Compatível com Desenvolvimento Local e Produção (Render + Supabase + Resend + Stripe)
# ============================================================

# --- Ambiente e URL Pública ---
FLASK_ENV=development
FLASK_SECRET_KEY=GERE_UMA_CHAVE_ALEATORIA_FORTE_AQUI
APP_BASE_URL=http://localhost:5000
TRIAL_DIAS=7

# ============================================================
#  BANCO DE DADOS — PostgreSQL Local OU Supabase (DATABASE_URL)
# ============================================================
# Em produção no Supabase, preencha DATABASE_URL (Transaction/Session Pooler)
# Exemplo: postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Alternativa local (usada apenas se DATABASE_URL estiver vazio):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sgpp
DB_USER=postgres
DB_PASSWORD=SUA_SENHA_AQUI
DB_POOL_MIN=1
DB_POOL_MAX=10

# ============================================================
#  SUPABASE STORAGE — Persistência de Logos e Planilhas no Render
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sgpp-arquivos

# ============================================================
#  E-MAIL TRANSACIONAL — Resend (Recomendado em Produção)
# ============================================================
# Crie sua API Key em https://resend.com/api-keys e valide o domínio em Domains
RESEND_API_KEY=
RESEND_FROM_NAME=SGPP - Gestão Pedagógica
RESEND_FROM_EMAIL=noreply@seudominio.com.br
RESEND_REPLY_TO=

# Fallback opcional via SMTP (usado apenas se RESEND_API_KEY estiver vazio):
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_NAME=SGPP - Gestão Pedagógica
SMTP_FROM_EMAIL=

# ============================================================
#  PAGAMENTOS E ASSINATURAS — Stripe
# ============================================================
# Chaves em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# IDs dos preços recorrentes (price_...) criados no Catálogo de Produtos da Stripe:
STRIPE_PRICE_MENSAL=
STRIPE_PRICE_TRIMESTRAL=
STRIPE_PRICE_SEMESTRAL=
STRIPE_PRICE_ANUAL=

# ============================================================
#  INTELIGÊNCIA ARTIFICIAL
# ============================================================
# Em produção no Render use: IA_PROVIDER=gemini (ou groq / openai)
IA_PROVIDER=gemini

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=60

# Ollama local (apenas desenvolvimento offline)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# OpenAI / Groq (opcionais)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Servidor Local (Waitress) ---
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_THREADS=4
